# Optional overrides for docker compose. Copy to .env only if the defaults do not fit.
# No secrets are needed here: the cms container generates its own on first start.

# Host port of the web application (default 4200).
WEB_PORT=
# Host port of Strapi (default 1337).
CMS_PORT=
# Comma-separated origins of the web application allowed by Strapi's CORS
# (default http://localhost:4200,http://localhost:8080).
WEB_ORIGINS=

# End-to-end tests (`npm run test:e2e`), read only by the Node test runner, never by the browser.
# Address of the web application (default http://localhost:4200).
E2E_BASE_URL=
# Address of Strapi for the AC-007 content-change test (default http://localhost:1337).
E2E_CMS_URL=
# Fictitious Strapi administrator used by that test. Leave empty on a fresh stack
# (`docker compose down -v`): the test then registers one with random credentials.
E2E_STRAPI_ADMIN_EMAIL=
E2E_STRAPI_ADMIN_PASSWORD=
