# Copy to .env for local development (`npm run dev:cms`). Docker Compose generates the secrets itself.

# Server
HOST=
PORT=
# Comma-separated origins allowed by CORS (the web application).
CORS_ORIGIN=

# Secrets: random values, never committed (generate with `openssl rand -base64 32`).
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (SQLite file relative to apps/cms)
DATABASE_CLIENT=
DATABASE_FILENAME=
