{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": {
    "singularName": "country",
    "pluralName": "countries",
    "displayName": "Country",
    "description": "A country served by the wizard: identity, formatting, theme, wizard copy, plan list copy, summary copy and terms (ADR-001)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z]{2}$"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "currency": {
      "type": "string",
      "required": true,
      "regex": "^[A-Z]{3}$"
    },
    "formatLocale": {
      "type": "string",
      "required": true
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "country.theme"
    },
    "copy": {
      "type": "component",
      "repeatable": false,
      "component": "country.wizard-copy",
      "required": true
    },
    "planCopy": {
      "type": "component",
      "repeatable": false,
      "component": "country.plan-copy",
      "required": true
    },
    "summaryCopy": {
      "type": "component",
      "repeatable": false,
      "component": "country.summary-copy",
      "required": true
    },
    "steps": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::wizard-step.wizard-step",
      "mappedBy": "country"
    },
    "plans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::plan.plan",
      "mappedBy": "country"
    },
    "terms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::terms.term",
      "mappedBy": "country"
    }
  }
}
