#!/bin/sh
# managed by roclec-spec-kit
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
project_relative=.
project_root=$(CDPATH= cd -- "$repo_root/$project_relative" && pwd)
if [ -x "$project_root/.venv/bin/roclec" ]; then cli="$project_root/.venv/bin/roclec"; elif [ -x "$repo_root/.venv/bin/roclec" ]; then cli="$repo_root/.venv/bin/roclec"; else cli=$(command -v roclec) || { echo "Install roclec-spec-kit in the project .venv" >&2; exit 127; }; fi
exec "$cli" --project "$project_root" "$@"
